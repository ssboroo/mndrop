{
  "name": "beauty-drop-mongolia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare:source": "node scripts/prepare.mjs",
    "dev": "npm run prepare:source && next dev --hostname 0.0.0.0",
    "build": "npm run prepare:source && prisma generate && next build",
    "start": "next start --hostname 0.0.0.0 -p ${PORT:-3000}",
    "db:migrate": "prisma migrate deploy",
    "test": "npm run prepare:source && node --experimental-strip-types --test tests/runtime.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@base-ui/react": "^1.7.0",
    "@prisma/client": "6.19.0",
    "@tailwindcss/postcss": "4.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "motion": "^13.4.6",
    "next": "16.3.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.2.1",
    "three": "^0.186.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "prisma": "6.19.0",
    "typescript": "5.9.3"
  }
}
