generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
model User {
 id String @id @default(uuid())
 email String @unique
 createdAt DateTime @default(now())
 sessions Session[]
}
model Session {
 tokenHash String @id
 userId String
 expiresAt DateTime
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@index([expiresAt])
}
model EmailToken {
 tokenHash String @id
 email String
 expiresAt DateTime
 @@index([expiresAt])
}
model RateLimit {
 key String @id
 count Int @default(0)
 window DateTime
}
model CustomerItem {
 userId String @map("user_id")
 kind String
 dropId String @map("drop_id")
 variant String @default("")
 quantity Int @default(1)
 createdAt String @map("created_at")
 @@id([userId,kind,dropId,variant])
 @@map("customer_items")
}
model Campaign {
 id String @id @default(uuid())
 name String
 brand String
 status String @default("DRAFT")
 opensAt String @map("opens_at")
 closesAt String @map("closes_at")
 authorizationId String? @map("authorization_id")
 approvedBy String? @map("approved_by")
 closedAt String? @map("closed_at")
 createdBy String @map("created_by")
 createdAt String @map("created_at")
 titleMn String?
 descriptionEn String?
 descriptionMn String?
 refundPolicyEn String?
 refundPolicyMn String?
 sourcingEn String?
 sourcingMn String?
 deliveryEn String?
 deliveryMn String?
 mediaUrl String?
 embargoAt DateTime?
 contentApprovedAt DateTime?
 products Product[]
 orders Order[]
 purchaseOrders PurchaseOrder[]
 @@index([status,closesAt])
 @@map("campaigns")
}
model Authorization {
 id String @id @default(uuid())
 brand String
 documentUrl String @map("document_url")
 validUntil String @map("valid_until")
 createdBy String @map("created_by")
 approvedBy String?
 @@map("authorizations")
}
model Product {
 id String @id @default(uuid())
 campaignId String
 sku String
 name String
 nameMn String
 ingredientsEn String
 ingredientsMn String
 usageEn String
 usageMn String
 campaign Campaign @relation(fields:[campaignId],references:[id])
 variants Variant[]
 @@unique([campaignId,sku])
}
model Variant {
 id String @id @default(uuid())
 productId String
 code String
 name String
 priceMnt Int
 mapMnt Int
 allocation Int
 reserved Int @default(0)
 paid Int @default(0)
 maxPerCustomer Int
 moq Int
 product Product @relation(fields:[productId],references:[id])
 lines OrderLine[]
 @@unique([productId,code])
}
model AuditLog {
 id String @id @default(uuid())
 actor String
 action String
 recordId String @map("record_id")
 detail String
 createdAt String @map("created_at")
 @@index([createdAt])
 @@map("audit_logs")
}
model Order {
 id String @id @default(uuid())
 userId String @map("user_id")
 campaignId String @map("campaign_id")
 status String @default("PAYMENT_PENDING")
 totalMnt Int @map("total_mnt")
 paymentReference String? @unique @map("payment_reference")
 createdAt String @map("created_at")
 invoiceId String? @unique
 paymentId String? @unique
 expiresAt DateTime?
 paymentVerifiedAt DateTime?
 shippingStatus String?
 trackingNumber String?
 trackingUrl String?
 addressJson String?
 campaign Campaign @relation(fields:[campaignId],references:[id])
 lines OrderLine[]
 events OrderEvent[]
 @@index([userId,createdAt])
 @@index([status,expiresAt])
 @@map("orders")
}
model OrderLine {
 id String @id @default(uuid())
 orderId String @map("order_id")
 sku String
 variant String
 quantity Int
 unitMnt Int @map("unit_mnt")
 variantId String?
 order Order @relation(fields:[orderId],references:[id])
 variantRecord Variant? @relation(fields:[variantId],references:[id])
 @@index([orderId])
 @@map("order_lines")
}
model OrderEvent {
 id String @id @default(uuid())
 orderId String
 state String
 note String
 createdAt DateTime @default(now())
 order Order @relation(fields:[orderId],references:[id])
}
model PurchaseOrder {
 id String @id @default(uuid())
 campaignId String
 status String @default("PREPARED")
 quantitiesJson String
 approvedBy String?
 approvedAt DateTime?
 supplierReference String?
 supplierInvoiceUrl String?
 campaign Campaign @relation(fields:[campaignId],references:[id])
 @@index([campaignId])
}
model Job {
 id String @id @default(uuid())
 kind String
 payloadJson String
 status String @default("PENDING")
 attempts Int @default(0)
 runAt DateTime @default(now())
 lockedAt DateTime?
 lastError String?
 @@index([status,runAt])
}

model ModelJob {
 id String @id
 name String
 createdBy String @map("created_by")
 createdAt String @map("created_at")
 status String
 progress Int @default(0)
 sourceKind String @map("source_kind")
 providerId String? @map("provider_id")
 assetKey String? @map("asset_key")
 dropId String? @map("drop_id")
 approvedBy String? @map("approved_by")
 approvedAt String? @map("approved_at")
 error String?
 @@index([createdBy,createdAt],map:"idx_model_owner")
 @@index([dropId,status],map:"idx_model_public")
 @@map("model_jobs")
}

model CommerceAuthTokens {
 hash String @id
 email String
 expires_at String
 @@map("commerce_auth_tokens")
}

model CommerceContacts {
 user_id String @id
 email String
 @@map("commerce_contacts")
}

model CommerceContent {
 campaign_id String @id
 content String
 review_by String?
 review_at String?
 @@map("commerce_content")
}

model CommerceDecisions {
 order_id String @id
 state String
 valid Int
 @@map("commerce_decisions")
}

model CommerceEvents {
 id String @id
 order_id String
 state String
 note String
 created_at String
 @@unique([order_id,state])
 @@map("commerce_events")
}

model CommerceImports {
 id String @id
 partner_id String
 format String
 payload String
 status String @default("REVIEW")
 created_by String
 created_at String
 @@map("commerce_imports")
}

model CommerceJobs {
 id String @id
 kind String
 payload String
 status String @default("PENDING")
 attempts Int @default(0)
 run_at String
 lock_at String?
 error String?
 @@map("commerce_jobs")
}

model CommerceLineVariants {
 line_id String @id
 variant_id String
 @@map("commerce_line_variants")
}

model CommerceMedia {
 id String @id
 asset_key String
 type String
 approved_by String?
 created_by String
 created_at String
 @@map("commerce_media")
}

model CommerceOrderMeta {
 order_id String @id
 email String
 address String
 expires_at String
 idempotency String @unique
 invoice_id String? @unique
 invoice_data String?
 callback_hash String
 shipping_state String @default("PRE_ORDER")
 tracking String?
 supplier_reference String?
 checked_at String?
 @@map("commerce_order_meta")
}

model CommercePurchaseOrders {
 id String @id
 campaign_id String @unique
 status String
 quantities String
 approved_by String?
 approved_at String?
 supplier_reference String?
 invoice_url String?
 created_at String
 @@map("commerce_purchase_orders")
}

model CommerceRate {
 key String @id
 count Int
 @@map("commerce_rate")
}

model CommerceReceipts {
 payment_id String @id
 order_id String
 amount_mnt Int
 verified_at String
 evidence String
 @@map("commerce_receipts")
}

model CommerceSessions {
 hash String @id
 user_id String
 email String
 expires_at String
 @@map("commerce_sessions")
}

model CommerceTickets {
 id String @id
 user_id String
 email String
 order_id String?
 subject String
 message String
 status String @default("OPEN")
 response String?
 created_at String
 @@map("commerce_tickets")
}

model CommerceUsage {
 user_id String
 variant_id String
 quantity Int
 max_quantity Int
 @@id([user_id,variant_id])
 @@map("commerce_usage")
}

model CommerceVariants {
 id String @id
 campaign_id String
 sku String
 label String
 price_mnt Int
 map_mnt Int
 allocation Int
 reserved Int @default(0)
 paid_qty Int @default(0)
 moq Int
 max_per_customer Int
 @@unique([campaign_id,sku,label])
 @@map("commerce_variants")
}

model CommerceProfiles {
 user_id String @id
 data String
 updated_at String
 @@map("commerce_profiles")
}
